# Copy this file to .env and fill in your keys — or just enter them on the
# Settings page in the app, which writes this file for you and uses the keys
# immediately, with no restart.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
#
# Edited by hand, this file is read at startup, so restart the server. A
# variable already set in the shell takes precedence over it.

# Which model provider to use: claude (default) or groq. Pick it on the
# Settings page, or set it here.
# LLM_PROVIDER=claude

# Claude — drafted comments, interest chips and the focus line.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# Groq — the same three, through an OpenAI-compatible endpoint.
# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Any other OpenAI-compatible host, e.g. a local Ollama:
# GROQ_BASE_URL=http://localhost:11434/v1

# Keys for both can sit here at once; LLM_PROVIDER decides which is called.

# Web research: company descriptions, the company web panel, LinkedIn activity
# links. Without this, run_pipeline.py exits immediately. https://firecrawl.dev
FIRECRAWL_API_KEY=

# Who the drafted outreach is signed by. These are the defaults, so the app
# works with them unset.
# OUTREACH_SENDER_NAME=Rahul Goenka
# OUTREACH_SENDER_ROLE=Head of Marketing
# OUTREACH_SENDER_COMPANY=Screwdriver

# Where the SQLite file lives. Defaults to ./data next to this file.
# PEOPLEINTEL_DATA=
