# Copy this file to .env and fill in your keys. .env is read at startup by
# app/env.py; a variable already set in the shell takes precedence over it.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)
#
# Restart the server after editing — it does not watch this file.

# Web research: company descriptions, the Google/Web panel, LinkedIn activity
# links. Without this, run_pipeline.py exits immediately. https://firecrawl.dev
FIRECRAWL_API_KEY=

# Interest chips and the focus line. Any OpenAI-compatible endpoint.
# Groq: https://console.groq.com/keys — free tier is enough.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Self-hosted Ollama instead, which needs no key:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3
# LLM_API_KEY=ollama
